# StudyGen AI – Environment Configuration
# =========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Your Groq API key (get one free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Text generation model (open-source LLM via Groq)
GROQ_MODEL=llama3-70b-8192

# Vision model for image/textbook analysis
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Whisper model for speech-to-text
GROQ_STT_MODEL=whisper-large-v3-turbo

# Flask secret key (change this to a random string in production)
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
